# Secrets - never commit
/app/etc/env.php
/auth.json

# Composer / npm dependencies (reinstall via composer install / npm install)
/vendor/
/node_modules/
/vendor/hyva-themes/magento2-default-theme/web/tailwind/node_modules/

# Generated / compiled / cache / media (regenerated by Magento tooling)
/generated/
/var/*
!/var/.htaccess
/pub/static/*
!/pub/static/.htaccess
/pub/media/*
!/pub/media/.htaccess
!/pub/media/customer/
/pub/media/customer/*

# Setup / deployment artifacts
/app/etc/vendor_path.php
/dev/tests/**/etc/local-*.xml
/dev/tests/**/report/
/dev/tests/**/tmp/

# IDE / OS
/.idea/
/.vscode/
.DS_Store
*.swp

# Sample data media archives (large, reproducible via composer package)
/var/composer_home/
